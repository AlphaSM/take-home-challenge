# Clever Dictate — environment template.
# Copy to `.env` (which is gitignored — never commit real keys):
#   cp .env.example .env
# The defaults below run the app fully offline with deterministic mock
# providers: no API keys, no GPU, no network needed.

# Required. SQLite for local dev; the schema is Postgres-ready.
DATABASE_URL="file:./dev.db"

# Pipeline providers: "mock" (offline, default) or "gemini" (live cloud).
# LLM also accepts "anthropic"; STT also accepts "openai" (Whisper API).
VLM_PROVIDER=mock
STT_PROVIDER=mock
LLM_PROVIDER=mock

# --- Live Gemini (optional) -------------------------------------------------
# Set the three providers above to "gemini" and supply a Google AI Studio key
# (https://aistudio.google.com/apikey). Both key forms work: AIza... and AQ....
#GEMINI_API_KEY=

# Model pins (optional; defaults shown). gemini-3.5-flash is verified for
# text, vision AND one-shot audio transcription on the free tier.
#   - gemini-3.1-pro-preview needs a billing-enabled project (free tier = 0).
#   - gemini-3.1-flash-live-preview is WebSocket-only (Live API) and cannot
#     serve the one-shot STT interface.
#GEMINI_VLM_MODEL=gemini-3.5-flash
#GEMINI_LLM_MODEL=gemini-3.5-flash
#GEMINI_STT_MODEL=gemini-3.5-flash

# Comma-separated models tried when the primary hits persistent 429/503/404.
# Free-tier quotas are per-model buckets, so a fallback usually still has
# headroom when the primary is exhausted.
#GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite

# --- Other cloud providers (optional) ---------------------------------------
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
