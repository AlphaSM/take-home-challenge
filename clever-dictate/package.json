{
  "name": "clever-dictate",
  "version": "0.1.0",
  "private": true,
  "description": "Clever Dictate — context-aware, multi-user dictation for teams. VLM screenshot context → Whisper STT → LLM cleanup.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "setup": "prisma generate && prisma db push && npm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop:prepare": "npm run build && node desktop/scripts/prepare-db.mjs && npm --prefix desktop install",
    "desktop:dev": "npm --prefix desktop run dev",
    "desktop:dist": "npm --prefix desktop run dist:win"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "next": "15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.5.1",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
